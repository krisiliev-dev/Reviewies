coverage/

# A mutation run that was killed outright leaves one of these behind.
*.mutant-backup

# The scratch directory every agent is told to point TMPDIR at, because /tmp/metro-cache
# is shared across checkouts and silently poisons an export. It was untracked and
# unignored, which is one `git add -A` away from §6.158's mistake — 38 files and 6.3 MB
# committed because a convention existed and nothing wrote it down. Playwright and Metro
# both live in here during a run.
.tmp/

# `tsc -b` writes these beside each tsconfig; they are a build cache.
*.tsbuildinfo
mobile/dist-signedin

# The real pass's own export. It had shared `mobile/dist` with the fixture pass, so
# whichever ran last decided which provider the other was photographing. §6.153.
mobile/dist-real

# The web real pass's own export, for the reason §6.153 gives about `mobile/dist-real`:
# two passes sharing one build directory means whichever ran last decides which provider
# the other was photographing. §6.157.
app/dist-real
