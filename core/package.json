{
  "name": "@reviewies/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Everything that is not a screen: the domain model, the repository, metadata providers, sync, stats, and the importers. No DOM, no React Native, no assumptions about where it runs.",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:sqlite": "vitest run --config vitest.sqlite.config.ts",
    "test:tz": "TZ=Pacific/Kiritimati vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/sql.js": "^1.4.11",
    "dexie": "^4.4.5",
    "emojibase": "^17.0.0",
    "emojibase-data": "^17.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "react": "19.2.3",
    "sql.js": "^1.14.2",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
