# Copy to .env and fill in. .env is gitignored — never commit real values.

# TMDB: the API *Read Access Token* (v4 bearer), not the v3 "API Key".
# Settings → API → "API Read Access Token".
VITE_TMDB_TOKEN=

# Supabase: Project Settings → API.
# The anon/publishable key is safe in a client bundle — row-level security is what
# protects the data. NEVER put the service_role key here; it bypasses RLS entirely.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
